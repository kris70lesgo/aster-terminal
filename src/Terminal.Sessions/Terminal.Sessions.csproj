<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RuntimeIdentifiers>osx-arm64;win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Devolutions.Terminal.Control" Version="2026.3.4" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Protobuf Include="Scripting/api.proto" GrpcServices="None" />
  </ItemGroup>
  <ItemGroup>
    <None Update="ShellIntegration/*.bash;ShellIntegration/*.zsh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="ShellIntegration/zsh/.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
