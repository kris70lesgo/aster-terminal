<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Aster.App.Views"
             x:Class="Aster.App.App" Name="Aster Terminal" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ControlTheme x:Key="TerminalScrollThumbTheme" TargetType="Thumb">
        <Setter Property="Template"><ControlTemplate><Border Background="{DynamicResource ScrollThumb}" CornerRadius="4" Margin="1.25,1" /></ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="TerminalScrollPageTheme" TargetType="RepeatButton">
        <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" />
        <Setter Property="Template"><ControlTemplate><Border Background="Transparent" /></ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="TerminalScrollBarTheme" TargetType="views:TerminalScrollBar">
        <Setter Property="Template"><ControlTemplate>
          <Border Background="{DynamicResource ScrollTrack}" BorderBrush="{DynamicResource ScrollDivider}" BorderThickness="0.5,0,0,0" Margin="0,4,3,11">
            <Track Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}" Orientation="Vertical" IsDirectionReversed="True">
              <Track.DecreaseButton><RepeatButton Name="PART_PageUpButton" Focusable="False" Theme="{StaticResource TerminalScrollPageTheme}" AutomationProperties.Name="Page up" /></Track.DecreaseButton>
              <Track.IncreaseButton><RepeatButton Name="PART_PageDownButton" Focusable="False" Theme="{StaticResource TerminalScrollPageTheme}" AutomationProperties.Name="Page down" /></Track.IncreaseButton>
              <Thumb MinHeight="24" Theme="{StaticResource TerminalScrollThumbTheme}" AutomationProperties.Name="Scroll position" />
            </Track>
          </Border>
        </ControlTemplate></Setter>
      </ControlTheme>
      <ControlTheme x:Key="CaptionButtonTheme" TargetType="Button">
        <Setter Property="Template"><ControlTemplate><Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" Name="CaptionSymbol" /></Border></ControlTemplate></Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#CaptionSymbol"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.4" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="TerminalTabTheme" TargetType="TabItem">
        <Setter Property="FontSize" Value="13" /><Setter Property="Height" Value="29" />
        <Setter Property="Padding" Value="8,0" /><Setter Property="Foreground" Value="{DynamicResource MutedForeground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><ControlTemplate>
          <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="5" Margin="1,3" Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate></Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource TabHoverBackground}" /></Style>
        <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource SelectedTabBackground}" /><Setter Property="Foreground" Value="{DynamicResource ChromeForeground}" /></Style>
        <Style Selector="^.drop-before /template/ Border#TabBorder"><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="BorderBrush" Value="#6A9FE8" /></Style>
        <Style Selector="^.drop-after /template/ Border#TabBorder"><Setter Property="BorderThickness" Value="0,0,3,0" /><Setter Property="BorderBrush" Value="#6A9FE8" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="TerminalTabsTheme" TargetType="views:TerminalTabs">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template"><ControlTemplate>
          <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <Border Name="WindowHeader" Height="29" Background="{DynamicResource ChromeBackground}">
              <Grid RowDefinitions="*,1,1">
                <Grid ColumnDefinitions="78,*,64,10">
                  <views:WindowButtons />
                  <ScrollViewer Name="HeaderViewport" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                  </ScrollViewer>
                  <TextBlock Name="WindowCaption" Grid.Column="1" IsVisible="False" Text="{Binding $parent[Window].Title}" TextTrimming="CharacterEllipsis" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedForeground}" Margin="7,0,6,0" VerticalAlignment="Center" />
                  <TextBlock Name="WindowShortcut" Grid.Column="2" IsVisible="False" Text="{TemplateBinding WindowShortcut}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedForeground}" Opacity="0.4" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Window shortcut" />
                  <Button Name="NewTabButton" Grid.Column="2" Classes="chrome-button" Content="+" ToolTip.Tip="New tab" AutomationProperties.Name="New tab" FontSize="19" Padding="0" Width="28" Height="26" MinHeight="0" MinWidth="0" VerticalAlignment="Center" />
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource TabDivider}" />
                <Border Grid.Row="2" Background="{DynamicResource HeaderBottomEdge}" />
              </Grid>
            </Border>
            <ContentPresenter Grid.Row="1" Content="{TemplateBinding MenuBar}" />
            <ContentPresenter Grid.Row="2" Content="{TemplateBinding FindContent}" />
            <Panel Grid.Row="3" ClipToBounds="True">
              <ContentPresenter Name="PART_SelectedContentHost2" IsVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              <ContentPresenter Name="PART_SelectedContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            </Panel>
            <ContentPresenter Grid.Row="4" Content="{TemplateBinding StatusContent}" />
          </Grid>
        </ControlTemplate></Setter>
        <Style Selector="^.single /template/ ScrollViewer#HeaderViewport"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^.single /template/ TextBlock#WindowCaption"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^.single /template/ Button#NewTabButton"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^.single /template/ TextBlock#WindowShortcut"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^.inactive /template/ TextBlock#WindowCaption"><Setter Property="Opacity" Value="0.6" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="SettingsCategoryTheme" TargetType="TabItem">
        <Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="14,5" /><Setter Property="MinWidth" Value="76" />
        <Setter Property="Template"><ControlTemplate><Border Name="CategoryBorder" CornerRadius="6" Margin="2,4" Padding="{TemplateBinding Padding}"><ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
        <Style Selector="^:selected /template/ Border#CategoryBorder"><Setter Property="Background" Value="{DynamicResource SelectedTabBackground}" /></Style>
        <Style Selector="^:pointerover /template/ Border#CategoryBorder"><Setter Property="Background" Value="{DynamicResource TabHoverBackground}" /></Style>
      </ControlTheme>
      <ControlTheme x:Key="SettingsSegmentTheme" TargetType="TabItem">
        <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="12,3" />
        <Setter Property="Template"><ControlTemplate><Border Name="SegmentBorder" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1,0"><ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Setter>
        <Style Selector="^:selected /template/ Border#SegmentBorder"><Setter Property="Background" Value="{DynamicResource SelectedTabBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource MutedForeground}" /></Style>
      </ControlTheme>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackground">#15191E</SolidColorBrush>
          <SolidColorBrush x:Key="ChromeForeground">#E4E4E6</SolidColorBrush>
          <SolidColorBrush x:Key="TabHoverBackground">#2D2D35</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBackground">#303034</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorder">#55555B</SolidColorBrush>
          <SolidColorBrush x:Key="ChromeBackground">#21212D</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForeground">#9B9BA8</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollTrack">#21262B</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollDivider">#33383C</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollThumb">#919395</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedTabBackground">#3B3B43</SolidColorBrush>
          <SolidColorBrush x:Key="TabDivider">#232323</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBottomEdge">#222222</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackground">#FAFAFC</SolidColorBrush>
          <SolidColorBrush x:Key="ChromeForeground">#242424</SolidColorBrush>
          <SolidColorBrush x:Key="TabHoverBackground">#DCDCDC</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="ControlBorder">#B8B8BC</SolidColorBrush>
          <SolidColorBrush x:Key="ChromeBackground">#E8E8E8</SolidColorBrush>
          <SolidColorBrush x:Key="MutedForeground">#455368</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollTrack">#F1F1F1</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollDivider">#C4C4C4</SolidColorBrush>
          <SolidColorBrush x:Key="ScrollThumb">#909090</SolidColorBrush>
          <SolidColorBrush x:Key="SelectedTabBackground">#FAFAFC</SolidColorBrush>
          <SolidColorBrush x:Key="TabDivider">#C4C4C4</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBottomEdge">#C4C4C4</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Button.chrome-button"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource MutedForeground}" /></Style>
    <Style Selector="views|TerminalTabs.inactive TabItem"><Setter Property="Opacity" Value="0.65" /></Style>
    <Style Selector="views|TerminalTabs TabItem"><Setter Property="Theme" Value="{StaticResource TerminalTabTheme}" /></Style>
    <Style Selector="TabControl.settings-toolbar TabItem"><Setter Property="Theme" Value="{StaticResource SettingsCategoryTheme}" /></Style>
    <Style Selector="TabControl.profile-segments TabItem"><Setter Property="Theme" Value="{StaticResource SettingsSegmentTheme}" /></Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Styles>
</Application>
