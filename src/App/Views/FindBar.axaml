<Border xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Aster.App.Views.FindBar" IsVisible="False" Background="{DynamicResource ChromeBackground}" Padding="8,6">
  <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <TextBox x:Name="SearchBox" AutomationProperties.Name="Find terminal output" MinWidth="100" PlaceholderText="Find" KeyDown="SearchKeyDown" TextChanged="SearchTextChanged" />
    <ToggleButton x:Name="MatchCaseBox" Grid.Column="1" Content="Aa" AutomationProperties.Name="Match case" ToolTip.Tip="Match case" IsCheckedChanged="SearchOptionChanged" Margin="6,0,0,0" MinWidth="30" Padding="6,3" />
    <ToggleButton x:Name="RegexBox" Grid.Column="2" Content=".*" AutomationProperties.Name="Regular expression" ToolTip.Tip="Regular expression" IsCheckedChanged="SearchOptionChanged" Margin="4,0,0,0" MinWidth="30" Padding="6,3" />
    <ToggleButton x:Name="WholeWordBox" Grid.Column="3" Padding="6,3" Content="Word" AutomationProperties.Name="Whole word" ToolTip.Tip="Whole word" IsCheckedChanged="SearchOptionChanged" Margin="4,0,0,0" />
    <Button Grid.Column="4" Content="↑" AutomationProperties.Name="Previous match" ToolTip.Tip="Previous match (Shift+Enter)" Click="PreviousClicked" Margin="6,0,0,0" />
    <Button Grid.Column="5" Content="↓" AutomationProperties.Name="Next match" ToolTip.Tip="Next match (Enter)" Click="NextClicked" Margin="4,0,0,0" />
    <TextBlock x:Name="SearchStatus" Grid.Column="6" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
    <Button Grid.Column="7" Content="×" AutomationProperties.Name="Close find" ToolTip.Tip="Close find (Escape)" Click="DoneClicked" />
  </Grid>
</Border>
