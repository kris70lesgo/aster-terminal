<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Aster.App.Views"
        x:Class="Aster.App.Views.PreferencesWindow" x:CompileBindings="False" Title="Aster Terminal Settings"
        Width="940" Height="620" MinWidth="760" MinHeight="540" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" Background="{DynamicResource ChromeBackground}">
  <Window.Styles>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="3" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource ControlBackground}" /><Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="24" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="9,3" /></Style>
    <Style Selector="TextBlock"><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="12,6" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="32,*,Auto,Auto">
    <Border x:Name="SettingsCaption" Background="{DynamicResource ChromeBackground}" BorderBrush="{DynamicResource TabDivider}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="78,*,78"><views:WindowButtons /><TextBlock Grid.Column="1" Text="Settings" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
    </Border>
    <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="2" Classes="settings-toolbar" Margin="12,0">
      <TabItem x:Name="GeneralCategory">
        <TabItem.Header><StackPanel Spacing="3"><Viewbox Width="25" Height="25"><Path Width="24" Height="24" Stroke="{DynamicResource ChromeForeground}" StrokeThickness="1.3" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M12,7 L12,17 M7,12 L17,12" /></Viewbox><TextBlock Text="General" HorizontalAlignment="Center" /></StackPanel></TabItem.Header>
        <ScrollViewer>
        <StackPanel Spacing="12" Margin="18,18">
          <CheckBox x:Name="ReplayEnabledBox" Content="Keep screen replay in memory" />
          <TextBlock Text="Replay keeps a bounded history of visible text screens. It is discarded when the pane closes." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
          <Separator />
          <CheckBox x:Name="HotkeyWindowBox" Content="Summon a terminal with Ctrl+Alt+Space (Control+Option+Space on Mac)" />
          <TextBlock Text="Works while Aster is running. Press again while the window is active to hide it; its shell keeps running. Linux requires X11. Shortcut conflicts are reported after saving." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
          <Separator />
          <CheckBox x:Name="ScriptingEnabledBox" Content="Allow trusted Python scripts to control Aster" />
          <TextBlock Text="Scripts can read terminal contents, send commands and close sessions. Only local clients with your private Aster credential can connect. Disabled by default." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
          <Grid ColumnDefinitions="130,*"><TextBlock Text="Local API port:" VerticalAlignment="Center" /><NumericUpDown x:Name="ScriptingPortBox" Grid.Column="1" Width="130" HorizontalAlignment="Left" Minimum="1024" Maximum="65535" Increment="1" /></Grid>
          <Separator />
          <CheckBox x:Name="KeepSessionsAliveBox" Content="Recover live shells after a crash or detached window" />
          <TextBlock Text="Applies to new panes. Closing a pane or quitting normally still ends its processes. Detached hosts expire after 24 hours." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
          <CheckBox x:Name="RestoreLayoutBox" Content="Reopen tabs and split layouts on launch" />
          <TextBlock Text="Reopened panes start new shells. Running processes do not survive quitting." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
          <CheckBox x:Name="CopyOnSelectBox" Content="Copy text automatically after selection" />
          <CheckBox x:Name="ConfirmCloseBox" Content="Confirm before closing running sessions" />
          <TextBlock Text="Settings file:" Foreground="{DynamicResource MutedForeground}" /><TextBlock x:Name="SettingsPath" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="AppearanceCategory">
        <TabItem.Header><StackPanel Spacing="3"><Viewbox Width="25" Height="25"><Path Width="24" Height="24" Stroke="{DynamicResource ChromeForeground}" StrokeThickness="1.3" Data="M3,3 L21,3 L21,21 L3,21 Z M12,3 L12,21 M3,12 L21,12" /></Viewbox><TextBlock Text="Appearance" HorizontalAlignment="Center" /></StackPanel></TabItem.Header>
        <StackPanel Spacing="14" Margin="28,24">
          <Grid ColumnDefinitions="130,*"><TextBlock Text="Appearance:" VerticalAlignment="Center" /><ComboBox Grid.Column="1" x:Name="ThemeBox" Width="180" HorizontalAlignment="Left" /></Grid>
          <CheckBox x:Name="AlwaysShowTabBarBox" Content="Show tab bar even when there is only one tab" />
          <CheckBox x:Name="ShowStatusBarBox" Content="Show status bar" />
          <TextBlock Text="Tab titles fill the compact window header. A single tab shows its title; the tab strip appears when another tab is opened." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
        </StackPanel>
      </TabItem>
      <TabItem x:Name="ProfilesCategory">
        <TabItem.Header><StackPanel Spacing="3"><Viewbox Width="25" Height="25"><Path Width="24" Height="24" Stroke="{DynamicResource ChromeForeground}" StrokeThickness="1.3" Data="M2,4 L22,4 L22,20 L2,20 Z M5,8 L9,12 L5,16 M12,16 L18,16" /></Viewbox><TextBlock Text="Profiles" HorizontalAlignment="Center" /></StackPanel></TabItem.Header>
        <Grid ColumnDefinitions="200,20,*" Margin="0,14,12,0">
          <Grid RowDefinitions="*,Auto">
            <ListBox x:Name="ProfileList" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" Padding="0">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" Margin="0,8,0,0">
              <Button Content="+" ToolTip.Tip="Add profile" Click="AddClicked" /><Button Content="−" ToolTip.Tip="Remove profile" Click="RemoveClicked" /><Button Content="Duplicate" Click="DuplicateClicked" />
            </StackPanel>
          </Grid>
          <TabControl x:Name="ProfileTabs" Grid.Column="2" Classes="profile-segments">
            <TabItem Header="General">
              <ScrollViewer>
                <StackPanel Spacing="10" Margin="10,14">
                  <Grid ColumnDefinitions="115,*"><TextBlock Text="Name:" VerticalAlignment="Center" /><TextBox x:Name="ProfileName" Grid.Column="1" /></Grid>
                  <Grid ColumnDefinitions="115,*"><TextBlock Text="Command:" VerticalAlignment="Center" /><TextBox x:Name="ShellCommand" Grid.Column="1" /></Grid>
                  <Grid ColumnDefinitions="115,*"><TextBlock Text="Directory:" VerticalAlignment="Center" /><TextBox x:Name="StartingDirectory" Grid.Column="1" /></Grid>
                  <CheckBox x:Name="DefaultProfileBox" Content="Use as default profile" />
                  <CheckBox x:Name="ShellIntegrationBox" Content="Shell integration (bash and zsh)" />
                  <TextBlock Text="Environment variables:" /><TextBox x:Name="EnvironmentBox" AcceptsReturn="True" MinHeight="100" FontFamily="monospace" />
                  <TextBlock Text="One NAME=value per line. Command and environment changes apply to new sessions." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem x:Name="ProfileColorsTab" Header="Colors">
              <StackPanel Spacing="14" Margin="10,18">
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Foreground:" VerticalAlignment="Center" /><TextBox x:Name="ForegroundBox" Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="#RRGGBB" /></Grid>
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Background:" VerticalAlignment="Center" /><TextBox x:Name="BackgroundBox" Grid.Column="1" Width="160" HorizontalAlignment="Left" PlaceholderText="#RRGGBB" /></Grid>
                <TextBlock Text="Leave colours empty to follow the application theme." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
              </StackPanel>
            </TabItem>
            <TabItem x:Name="ProfileTextTab" Header="Text">
              <StackPanel Spacing="14" Margin="10,18">
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Font:" VerticalAlignment="Center" /><TextBox x:Name="FontFamilyBox" Grid.Column="1" /></Grid>
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Size:" VerticalAlignment="Center" /><NumericUpDown x:Name="FontSizeBox" Grid.Column="1" Width="120" HorizontalAlignment="Left" Minimum="6" Maximum="48" Increment="1" /></Grid>
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Cursor:" VerticalAlignment="Center" /><ComboBox x:Name="CursorBox" Grid.Column="1" Width="180" HorizontalAlignment="Left" /></Grid>
                <Grid ColumnDefinitions="115,*"><TextBlock Text="Scrollback:" VerticalAlignment="Center" /><NumericUpDown x:Name="HistorySizeBox" Grid.Column="1" Width="180" HorizontalAlignment="Left" Minimum="100" Maximum="100000" Increment="100" /></Grid>
                <TextBlock Text="Font changes apply immediately. Scrollback capacity applies to new sessions." TextWrapping="Wrap" Foreground="{DynamicResource MutedForeground}" />
              </StackPanel>
            </TabItem>
            <TabItem x:Name="ProfileTriggersTab" Header="Triggers"><ContentControl x:Name="TriggerEditorHost" /></TabItem>
          </TabControl>
        </Grid>
      </TabItem>
      <TabItem x:Name="KeysCategory">
        <TabItem.Header><StackPanel Spacing="3"><Viewbox Width="25" Height="25"><Path Width="24" Height="24" Stroke="{DynamicResource ChromeForeground}" StrokeThickness="1.3" Data="M2,5 L22,5 L22,19 L2,19 Z M5,8 L7,8 L7,10 L5,10 Z M10,8 L12,8 L12,10 L10,10 Z M15,8 L17,8 L17,10 L15,10 Z M6,14 L18,14 L18,16 L6,16 Z" /></Viewbox><TextBlock Text="Keys" HorizontalAlignment="Center" /></StackPanel></TabItem.Header>
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,18,12,0">
          <TextBlock Text="One Action=Gesture per line. Meta is Command on macOS. Each gesture must be unique." TextWrapping="Wrap" Margin="0,0,0,10" />
          <TextBox x:Name="ShortcutsBox" Grid.Row="1" AcceptsReturn="True" FontFamily="monospace" />
          <Button Grid.Row="2" Content="Restore default shortcuts" HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetShortcutsClicked" />
        </Grid>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="ErrorText" Grid.Row="2" Foreground="#DF665E" TextWrapping="Wrap" Margin="20,8" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,4,20,14">
      <Button Content="Cancel" Click="CancelClicked" /><Button Content="Save preferences" Click="SaveClicked" />
    </StackPanel>
  </Grid>
</Window>
