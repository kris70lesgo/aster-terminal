<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Aster.App.Views"
        x:Class="Aster.App.Views.MainWindow" Title="Aster Terminal"
        Width="1080" Height="680" MinWidth="620" MinHeight="320" Background="{DynamicResource WindowBackground}" WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True">
  <Grid>
    <views:TerminalTabs x:Name="Tabs" Classes="terminal-tabs" SelectionChanged="TabChanged">
    <views:TerminalTabs.MenuBar>
    <Menu x:Name="MainMenu" Background="{DynamicResource ChromeBackground}">
      <MenuItem Header="_Shell">
        <MenuItem Header="New tab" Click="NewTabClicked" /><MenuItem Header="New window" Click="NewWindowClicked" />
        <MenuItem x:Name="ProfilesMenu" Header="New tab with profile" /><Separator />
        <MenuItem Header="Close pane" Click="ClosePaneClicked" /><MenuItem Header="Close tab" Click="CloseTabClicked" />
        <MenuItem Header="Detach and close window" Click="DetachWindowClicked" /><MenuItem Header="Recover live sessions…" Click="RecoverSessionsClicked" />
        <MenuItem Header="Show hotkey window" Click="ShowHotkeyWindowClicked" />
        <MenuItem Header="Attach tmux session…" Click="AttachTmuxClicked" />
        <MenuItem Header="Save scrollback…" Click="SaveBufferClicked" /><Separator />
        <MenuItem Header="Preferences…" Click="PreferencesClicked" /><MenuItem Header="Quit" Click="QuitClicked" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Copy" Click="CopyClicked" /><MenuItem Header="Paste" Click="PasteClicked" />
        <MenuItem Header="Select all" Click="SelectAllClicked" /><Separator />
        <MenuItem Header="Find…" Click="FindClicked" /><MenuItem Header="Clear scrollback" Click="ClearBufferClicked" />
      </MenuItem>
      <MenuItem Header="_Session">
        <MenuItem Header="Split right" Click="SplitRightClicked" /><MenuItem Header="Split below" Click="SplitBelowClicked" />
        <MenuItem Header="Zoom active pane" Click="ZoomPaneClicked" /><MenuItem Header="Next pane" Click="NextPaneClicked" />
        <MenuItem Header="Next tab" Click="NextTabClicked" /><MenuItem Header="Rename tab…" Click="RenameClicked" />
        <MenuItem Header="Move tab left" Click="MoveTabLeftClicked" /><MenuItem Header="Move tab right" Click="MoveTabRightClicked" />
        <MenuItem Header="Open quickly…" Click="OpenQuicklyClicked" /><Separator />
        <MenuItem Header="Instant replay…" Click="ReplayClicked" /><Separator />
        <MenuItem Header="Add command mark" Click="AddMarkClicked" /><MenuItem Header="Previous mark" Click="PreviousMarkClicked" />
        <MenuItem Header="Next mark" Click="NextMarkClicked" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Larger font" Click="LargerFontClicked" /><MenuItem Header="Smaller font" Click="SmallerFontClicked" />
        <MenuItem Header="Reset font size" Click="ResetFontClicked" /><MenuItem Header="Toggle full screen" Click="FullScreenClicked" />
        <MenuItem x:Name="StatusBarMenuItem" ToggleType="CheckBox" Header="Show status bar" Click="StatusBarClicked" /><MenuItem x:Name="TabBarMenuItem" ToggleType="CheckBox" Header="Always show tab bar" Click="TabBarClicked" /><Separator />
        <MenuItem Header="Dark theme" Click="DarkThemeClicked" /><MenuItem Header="Light theme" Click="LightThemeClicked" />
      </MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="About Aster Terminal" Click="AboutClicked" /></MenuItem>
    </Menu>
    </views:TerminalTabs.MenuBar>
    <views:TerminalTabs.FindContent><views:FindBar x:Name="SearchBar" /></views:TerminalTabs.FindContent>
    <views:TerminalTabs.StatusContent>
    <Border x:Name="StatusBar" IsVisible="False" Background="{DynamicResource ChromeBackground}" Padding="10,5">
      <TextBlock x:Name="WindowStatus" FontSize="12" Foreground="{DynamicResource MutedForeground}" Text="Starting local shell…" />
    </Border>
    </views:TerminalTabs.StatusContent>
    </views:TerminalTabs>
    <Border ZIndex="10" x:Name="AlertBar" IsVisible="False" VerticalAlignment="Bottom" Margin="12" Padding="10,6" CornerRadius="3" Background="{DynamicResource ChromeBackground}">
      <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissAlertClicked" /><TextBlock x:Name="AlertText" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
    </Border>
  </Grid>
</Window>
